# ─── ARÊTE Intelligence Dashboard - Environment Variables ───
# 이 파일을 .env 로 복사하고 실제 값을 입력하세요.
# Windows: copy .env.example .env
# Mac/Linux: cp .env.example .env

# OpenAI GPT-4o
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 (선택 - SNS 에이전트에서 사용)
YOUTUBE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Instagram 로그인 (선택 - 공개 게시물만 볼 때는 불필요)
INSTAGRAM_USERNAME=jellygogo1
INSTAGRAM_PASSWORD=tjdan1020123!!

# 실행 설정
HEADLESS_MODE=true          # true: 브라우저 숨김, false: 브라우저 보임
SCRAPE_DELAY_MIN=1.0        # 스크래핑 최소 딜레이 (초) - 빠르게 줄임
SCRAPE_DELAY_MAX=2.5        # 스크래핑 최대 딜레이 (초) - 빠르게 줄임
MAX_PAGES=999               # 리뷰 수집 최대 페이지 (999 = 전수 수집)
EXPORT_DIR=./exports        # 결과 저장 폴더
